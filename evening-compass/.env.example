# ============================================================
# ВЕЧЕРНИЙ КОМПАС (Стоический вечерний чек-ин 2.0)
# ============================================================

# Токен отдельного Telegram-бота от @BotFather (например @evening_compass_bot)
TELEGRAM_BOT_TOKEN=

# Порт локального веб-сервера (по умолчанию 3001, чтобы не конфликтовать с кубиком на 3000)
PORT=3001

# Провайдер распознавания речи (Deepgram Nova-2 / Groq Whisper / OpenAI)
# Если ключ не указан, бот использует умный текстовый разбор + режим симуляции
DEEPGRAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Публичный URL для Telegram WebApp (если используется Cloudflare tunnel / Render / ngrok)
PUBLIC_URL=
